# 1. Unauthorized Host Modbus Communication (Not FUXA 192.168.10.20)
alert tcp !192.168.10.20 any -> 192.168.10.10 502 (msg:"OT-POLICY: Unauthorized Host Modbus Communication to PLC"; flow:to_server; classtype:policy-violation; sid:1000001; rev:1;)

# 2. Unauthorized Modbus Single Register Write (FC06)
alert tcp !192.168.10.20 any -> 192.168.10.10 502 (msg:"OT-ALERT: Unauthorized Modbus Single Write (FC06)"; flow:to_server,established; content:"|06|"; offset:7; depth:1; classtype:policy-violation; sid:1000002; rev:1;)

# 3. Unauthorized Modbus Multiple Registers Write (FC16)
alert tcp !192.168.10.20 any -> 192.168.10.10 502 (msg:"OT-ALERT: Unauthorized Modbus Multiple Write (FC16)"; flow:to_server,established; content:"|10|"; offset:7; depth:1; classtype:policy-violation; sid:1000003; rev:1;)

# 4. Modbus Force Single Coil (FC05 - Light override)
alert tcp any any -> 192.168.10.10 502 (msg:"OT-ATTACK: Modbus Force Single Coil (FC05)"; flow:to_server,established; content:"|05|"; offset:7; depth:1; classtype:attempted-admin; sid:1000004; rev:1;)

# 5. Modbus Force Multiple Coils (FC15 - Intersection override)
alert tcp any any -> 192.168.10.10 502 (msg:"OT-ATTACK: Modbus Force Multiple Coils (FC15)"; flow:to_server,established; content:"|0f|"; offset:7; depth:1; classtype:attempted-admin; sid:1000005; rev:1;)
